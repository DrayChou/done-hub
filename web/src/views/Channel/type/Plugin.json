{
  "1": {
    "chat_to_responses": {
      "name": "Chat 转 Responses",
      "description": "保持客户端 Chat 接口不变，把指定模型转到本渠道的 Responses 接口。仅在已确认上游支持 Responses 时配置；不根据平台名称猜测，不自动换模型。留空关闭。",
      "params": {
        "models": {
          "name": "需要转换的模型",
          "description": "逗号分隔的模型名（支持公开别名或映射后名称）；* 表示本渠道全部模型。与“Responses 转 Chat 兼容”方向相反。",
          "type": "string",
          "required": false
        }
      }
    }
  },
