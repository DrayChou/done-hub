  "25": {
    "gemini_signature_autofill": {
      "name": "缺失思考签名兼容",
      "description": "工具调用的真实 thoughtSignature 自动按调用 ID 缓存并回传。仅当已确认上游接受跳过校验标记时启用：缺签名时兜底，明确签名校验 400 时向同一渠道补救一次。首次保留真实签名，兼容降级可能丢失原思考链。适用于 Chat 转 Gemini 和原生 Gemini，不适用于 use_openai_api。",
      "params": {
        "enable": {
          "name": "启用缺签名兜底",
          "description": "缺签名或明确签名校验失败时使用 skip_thought_signature_validator；最多补救一次且共享原超时预算，默认关闭，不影响其他渠道。",
          "type": "bool",
          "required": true
        }
      }
    },
    "code_execution": {
      "name": "代码执行",
      "description": "使用代码执行功能，开启后，计算tokens不准确，建议个人使用开启",
      "params": {
        "enable": {
          "name": "启用",
          "description": "是否启用代码执行",
          "type": "bool",
          "required": true
